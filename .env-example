PORT=3000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=10

# Cadena larga y aleatoria (>= 32 caracteres). Ej: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Correo de confirmación (Gmail con contraseña de aplicación)
EMAIL_USER=
EMAIL_PASS=

# Orígenes del Front permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200,https://congreso-union.fesjaz.com

# Logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true = logs legibles en consola (solo desarrollo)
LOG_PRETTY=true

# BD para las pruebas automáticas (se borra y recrea en cada corrida; debe terminar en _test)
# Si no se define: <DB_NAME>_test
# TEST_DB_NAME=registro_usuarios_evento_test

# ── V2 multitenant ──────────────────────────────────────────────────────
# Dominios base: {slug}.<dominio> identifica al cliente y pasa CORS
# Producción: el dominio real (ej. tuapp.com). Local: localhost (pacific.localhost:4200)
APP_BASE_DOMAINS=localhost
# Subdominio del panel de plataforma (sin cliente)
PLATFORM_SUBDOMAIN=app
# Sesión: access token corto + refresh token en cookie httpOnly
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax: Front y API en el mismo dominio (pacific.tuapp.com / api.tuapp.com)
# none: dominios distintos (requiere HTTPS)
COOKIE_SAMESITE=lax
# auto = solo en producción
COOKIE_SECURE=auto
# Bloqueo de cuenta por intentos fallidos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
